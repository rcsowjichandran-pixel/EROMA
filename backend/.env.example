SECRET_KEY=generate-a-unique-random-value-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@eroma.in
SUPPORT_NOTIFICATION_EMAIL=hello@eroma.in
# Optional Resend API key for transactional mail over HTTPS. Use a verified sender domain.
RESEND_API_KEY=
# Configure these for SMTP delivery when RESEND_API_KEY is empty.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Leave blank for SQLite local development.
DATABASE_URL=
# Optional durable S3-compatible media storage for uploaded product images.
# Configure bucket read access for public product photos before enabling.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# Keep provider keys in backend/.env; never expose them through VITE_ variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
