SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@eroma.in
# Configure these for password reset email delivery outside local development.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Leave blank for SQLite local development.
DATABASE_URL=
# Keep provider keys in backend/.env; never expose them through VITE_ variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
