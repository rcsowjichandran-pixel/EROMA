# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Provider credentials belong in backend/.env, never in Vite/client variables.
/backend/.env
/backend/.env.*
!/backend/.env.example
/frontend/.env.local
/frontend/.env.*.local

# Private keys and credentials
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
service-account*.json

# Dependencies and generated files
node_modules/
frontend/dist/
backend/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
backend/db.sqlite3
backend/db-local-backup.sqlite3
backend/eroma-local-catalog.json
backend/render-catalog-before.json
/eroma-catalog.json
*.dump
*.backup
*.log
/.handoff-work/
/handoff/

# Operating system files
.DS_Store
Thumbs.db

# Local config/commands to ignore
/backend/config/settings.py
/backend/store/management/commands/sync_catalog_from_sqlite.py
